{
  "name": "sesshuttle",
  "version": "0.9.0",
  "private": true,
  "description": "Encrypted, user-owned Codex conversation sync",
  "author": {
    "name": "expldfsh",
    "email": "expldfsh@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/core/*.test.mjs",
    "test:windows": "node --test tests/core/windows-paths.test.mjs tests/core/connection-rules.test.mjs tests/core/history-items.test.mjs tests/core/workspace.test.mjs tests/core/recovery-file.test.mjs tests/core/activity.test.mjs tests/core/storage.test.mjs tests/core/shown-paths.test.mjs",
    "check": "node node_modules/typescript-native/bin/tsc --noEmit && node scripts/check-locales.mjs",
    "format": "prettier --write app core scripts tests eslint.config.mjs vite.config.ts",
    "format:check": "prettier --check app core scripts tests eslint.config.mjs vite.config.ts",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.mjs",
    "icon": "node scripts/icon.mjs",
    "licenses": "node scripts/licenses.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux deb tar.gz --x64 --publish never",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "build": {
    "appId": "com.expldfsh.sesshuttle",
    "productName": "sesshuttle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "assets/font-licenses/**/*",
      "assets/fonts.json",
      "!dist/macos-keychain.node",
      "!dist/**/*.map",
      "!dist/sesshuttle-start.cjs",
      "!dist/macos-launcher",
      "!dist/Sesshuttle.exe",
      "!dist/windows-build/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": "dmg",
      "extraResources": [
        {
          "from": "dist/macos-keychain.node",
          "to": "macos-keychain.node"
        }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "deb",
        "tar.gz"
      ],
      "executableName": "sesshuttle",
      "syncDesktopName": true
    },
    "win": {
      "target": "zip",
      "executableName": "Sesshuttle",
      "signAndEditExecutable": false
    },
    "icon": "assets/icon.png",
    "artifactName": "sesshuttle-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "afterPack": "scripts/package-launcher.cjs",
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "zenity | kdialog"
      ]
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@smithy/node-http-handler": "4.14.1",
    "dbus-next": "0.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "resedit": "1.7.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.5"
  },
  "homepage": "https://github.com/expldfsh/Sesshuttle",
  "desktopName": "sesshuttle.desktop"
}
